html(lang="hr")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Sve propusnice
    style.
      body {
        font-family: Arial, sans-serif;
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
        color: #222;
      }
      h1 { margin-bottom: 20px; }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      th, td {
        border: 1px solid #ddd;
        padding: 12px;
        text-align: left;
      }
      th { background: #f2f2f2; }
      .active { color: green; font-weight: bold; }
      .cancelled { color: #c00; font-weight: bold; }
      form { display: inline; }
      button {
        padding: 7px 10px;
        margin: 2px;
        cursor: pointer;
      }
      .delete { background: #c62828; color: white; border: none; }
      .cancel { background: #efefef; border: 1px solid #ccc; }
      .back { display: inline-block; margin-bottom: 15px; }
      a { text-decoration: none; color: black }
  body
    a.back(href="/") Povratak na početnu
    h1 Sve propusnice

    if passes && passes.length
      table
        thead
          tr
            th ID
            th Ime i prezime
            th Dokument
            th Vrijeme izdavanja
            th Status
            th Akcije
        tbody
          each pass in passes
            tr
              td= pass.id
              td= pass.name
              td= pass.document
              td= new Date(pass.issued_at).toLocaleString('hr-HR')
              td
                if pass.status === 'ACTIVE'
                  span.active Aktivna
                else
                  span.cancelled Poništena
              td
                a(href=`/info/${pass.id}`) Javne informacije
                br
                if pass.status === 'ACTIVE'
                  form(method="POST" action=`/passes/${pass.id}/cancel`)
                    button.cancel(type="submit") Poništi
                form(method="POST" action=`/passes/${pass.id}/delete` onsubmit="return confirm('Želite li zaista obrisati ovu propusnicu?')")
                  button.delete(type="submit") Obriši
    else
      p Trenutačno nema propusnica.
html 
    head 
        title WEB2 Lab1
    body
        if username
            h1 Welcome #{username}
        ul 
            li: a(href='/', title='Home') Home
            li: a(href='/private') Private content             
            if username
                li: form(action="/logout", method="post")
                    input(type="submit", value="Logout " + username)
            else
                li: a(href='/sign-up', title='Sign up') Sign up 
            if totalPasses !== undefined && activePasses !== undefined
                li: div Passes (Total: #{totalPasses}, Active: #{activePasses})
        